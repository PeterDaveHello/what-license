{
  "name": "what-license",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-friendly browser-only open-source license identifier",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterDaveHello/what-license.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "licenses:refresh": "node scripts/refresh-spdx.mjs",
    "licenses:verify": "node scripts/verify-license-data.mjs",
    "licenses:update-readme": "node scripts/update-supported-list.mjs"
  },
  "keywords": [
    "license",
    "spdx"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.20.0",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
